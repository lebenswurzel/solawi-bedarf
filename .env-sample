DATABASE_EXTERNAL_PORT=5532
BACKEND_EXTERNAL_PORT=3100
FRONTEND_EXTERNAL_PORT=8184
PHP_EXTERNAL_PORT=8180

TIMEZONE=Europe/Berlin

# Uncomment on a host where Traefik routes this stack and you start Compose by hand.
# Copying this file for local ports does not require a Traefik network.
# An Ansible deploy writes APP_DOMAIN from the app_domain host var instead.
# APP_DOMAIN=bedarf.example.org
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=web
# Second stack on one Traefik. Ansible writes this from instance_name.
# TRAEFIK_ROUTER=solawi-bedarf-bedarftest
# To leave host ports unpublished, also pass -f compose.no-host-ports.yaml.
# That needs Docker Compose 2.24 or newer.
# TRAEFIK_WEB_PORT belongs in /home/<user>/traefik/.env, not in this file. Set it when port 80 is already taken.
# Only when Traefik itself terminates TLS (compose.traefik.tls.yaml) and the entrypoint is websecure:
# TRAEFIK_CERTRESOLVER=letsencrypt
