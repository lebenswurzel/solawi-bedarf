# Shape of env-backup.env on the server. Ansible writes that file from inventory
# host vars (backup_age_recipient, backup_nextcloud_webdav_url,
# backup_nextcloud_share_token). The script skips its work when the file is missing.
#
# Lines are KEY=VALUE. A line whose first non-space character is # is a comment.
# Quote a value that contains spaces.
#
# AGE_RECIPIENT is the public line from `age-keygen -y identity.txt`.
# Store identity.txt in KeePass. Leave it off the server and out of this file.

AGE_RECIPIENT=age1...

# File-drop share (upload only). The WebDAV username is the share token.
NEXTCLOUD_WEBDAV_URL=https://cloud.example/public.php/webdav
NEXTCLOUD_SHARE_TOKEN=
# Leave empty when the share has no password.
NEXTCLOUD_SHARE_PASSWORD=

# Optional absolute paths, separated by spaces and included under extra/ in the archive.
# Quote the value when listing more than one path.
# OFFSITE_EXTRA_FILES="/home/user/traefik/.env /home/user/other.env"

# Newest database dump must be younger than this many seconds. Default is 6 hours.
# MAX_DUMP_AGE_SECONDS=21600

# Unsent encrypted archives kept locally when upload fails. Default is 7.
# OFFSITE_RETRY_KEEP=7
